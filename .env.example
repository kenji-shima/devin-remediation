# Devin
# NOTE: must be an admin-role key -- a regular "member" service-user key 403s
# on create_as_user_id (confirmed via direct testing against the live API).
DEVIN_API_KEY=
DEVIN_ORG_ID=
# Optional: attributes API-created sessions to this human user in the Devin
# dashboard instead of the API key's own service-user/bot identity.
DEVIN_USER_ID=
# Same admin-role key as DEVIN_API_KEY above, kept under its own name for
# one-off manual lookups that need elevated org permissions.
DEVIN_ADMIN_API_KEY=
# Optional: reusable "how to remediate a finding" playbook id.
# Sessions still work without it, just without the standing procedure.
DEVIN_PLAYBOOK_ID=

# GitHub (used by the poller for PR/CI/merge calls; unused until a fork is targeted)
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Webhook
WEBHOOK_SECRET=changeme

# Orchestrator behavior
ACU_CAP=10
MAX_CONCURRENT_SESSIONS=3

# Lifecycle poller
POLL_INTERVAL_SECONDS=20
SESSION_MAX_AGE_HOURS=2
ESCALATION_ACU_RATIO=0.85
AUTO_MERGE=true
MAX_CONCURRENT_HTTP=12

# Datastore
DATABASE_URL=sqlite:////app/data/orchestrator.db
